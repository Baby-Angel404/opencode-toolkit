#!/usr/bin/env bash
# Run the toolkit straight from a checkout, with nothing installed.
#
# Why this exists: `pip install -e .` is the supported install, but it needs a
# virtualenv and a build step. This script needs neither. It picks the first
# interpreter that can import the package and runs it, so a fresh clone gives a
# working CLI with one command:
#
#     ./opencode doctor
#
# Resolution order:
#   1. ./.venv/bin/python           the project's own environment, if present
#   2. an already-installed `opencode` on PATH
#   3. python3 with PYTHONPATH=src  a bare checkout
#
# The runtime is standard library only, so step 3 works on any Python >= 3.10.

set -uo pipefail

readonly PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "${PROJECT_ROOT}/.venv/bin/python" ]] \
    && "${PROJECT_ROOT}/.venv/bin/python" -c 'import opencode_toolkit' >/dev/null 2>&1; then
  exec "${PROJECT_ROOT}/.venv/bin/python" -m opencode_toolkit "$@"
fi

if command -v opencode >/dev/null 2>&1; then
  exec opencode "$@"
fi

for candidate in "${PROJECT_ROOT}/.venv/bin/python" python3 python; do
  if command -v "${candidate}" >/dev/null 2>&1; then
    if "${candidate}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
        >/dev/null 2>&1; then
      PYTHONPATH="${PROJECT_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}" \
        exec "${candidate}" -m opencode_toolkit "$@"
    fi
    printf 'error: %s is too old; Python 3.10 or newer is required\n' "${candidate}" >&2
    exit 3
  fi
done

printf 'error: no Python interpreter found. Install Python 3.10+ or run: pip install -e .\n' >&2
exit 3
