# Secrets -- never commit these. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
credentials
secrets.yaml
secrets.yml
secrets.json
.kaggle
token

# Python build and cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Tool state that is machine-local and may contain project content: snapshots,
# encrypted blobs, the offline queue, packs, logs, and the release gate.
# Regenerated by the toolkit.
.opencode/toolkit/snapshots/
.opencode/toolkit/queue/
.opencode/toolkit/orchestrator/
.opencode/toolkit/packs/
.opencode/toolkit/logs/
.opencode/toolkit/release-gate.json

# The configuration and the documentation baseline ARE tracked: CI needs both.
# Without the baseline, `docs check` reports every public item as new and the
# DOCUMENTATION stage fails for a reason that has nothing to do with the code.
# Without the configuration, the self-audit allow-list is empty and the
# SELF_AUDIT stage fails on findings the project has already reviewed.

# IDE and OS metadata
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Packaging output
out/
pip-wheel-metadata/
